{
  "name": "ai-sales-assistant",
  "version": "1.0.0",
  "description": "Telegram AI Sales Assistant monorepo",
  "scripts": {
    "dev": "concurrently -n web,api,bot -c cyan,green,yellow \"npm run dev -w @ai-sa/web\" \"npm run dev -w @ai-sa/api\" \"npm run dev -w @ai-sa/bot\"",
    "build": "npm run build --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate -w @ai-sa/api",
    "prisma:migrate": "npm run prisma:migrate -w @ai-sa/api"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^10.0.4",
    "localtunnel": "^2.0.2"
  }
}
